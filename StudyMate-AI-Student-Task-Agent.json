{
  "name": "StudyMate AI – Student Task Agent",
  "nodes": [
    {
      "parameters": {
        "formTitle": "StudyMate AI – Student Task Agent",
        "formDescription": "List your tasks and deadlines. StudyMate AI will prioritize them and email you a study plan.",
