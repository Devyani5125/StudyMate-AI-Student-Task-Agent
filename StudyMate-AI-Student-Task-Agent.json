              "requiredField": true
            },
            {
              "fieldLabel": "Tasks and Deadlines",
              "fieldType": "textarea",
              "fieldName": "tasks",
              "placeholder": "One task per line, e.g.\nMath assignment - due Oct 25\nPhysics lab report - due Oct 28",
              "requiredField": true
            },
            {
              "fieldLabel": "Study Hours Available Per Day",
              "fieldType": "number",
              "fieldName": "hours_per_day",
              "placeholder": "e.g. 3"
            }
          ]
        },
        "options": {
          "path": "studymate",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thanks! Your study plan will arrive by email shortly."
            }
          }
        }
      },
